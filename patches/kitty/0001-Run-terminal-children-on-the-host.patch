+        base = {'TERM': 'xterm-kitty', 'COLORTERM': 'truecolor'}
+        ans = host_env(dict(base), base, APP_PATH)
+        self.ae(ans['TERM'], 'xterm-kitty')
+        self.ae(ans['COLORTERM'], 'truecolor')
+
+    def test_message_codec_roundtrip(self):
