{
  "app-id": "io.github.kreed.KittyChrome",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "kitty-chrome",
  "finish-args": [
    "--allow=devel",
    "--device=dri",
    "--filesystem=host",
    "--filesystem=xdg-run/zellij",
    "--share=ipc",
    "--share=network",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--talk-name=org.freedesktop.Flatpak"
  ],
  "cleanup": [
    "/include",
    "/lib/cmake",
    "/lib/pkgconfig",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.a",
    "*.la"
  ],
  "modules": [
    {
      "name": "xxhash",
      "buildsystem": "simple",
      "build-commands": [
        "make -j${FLATPAK_BUILDER_N_JOBS}",
        "make PREFIX=/app install"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/Cyan4973/xxHash.git",
          "commit": "e626a72bc2321cd320e953a0ccf1584cad60f363"
        }
      ]
    },
    {
      "name": "simde",
      "buildsystem": "meson",
      "config-opts": [
        "-Dtests=false"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/simd-everywhere/simde.git",
          "commit": "71fd833d9666141edcd1d3c109a80e228303d8d7"
        }
      ]
    },
    {
      "name": "go-toolchain",
      "buildsystem": "simple",
      "build-commands": [
        "cp -a . /app/go"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://go.dev/dl/go1.26.5.linux-amd64.tar.gz",
          "sha256": "5c2c3b16caefa1d968a94c1daca04a7ca301a496d9b086e17ad77bb81393f053",
          "only-arches": [
            "x86_64"
          ]
        }
      ]
    },
    {
      "name": "slang-toolchain",
      "buildsystem": "simple",
      "build-commands": [
        "cp -a slang slangc slangd slangi /app/bin/",
        "cp -a lib*.so* /app/lib/"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/shader-slang/slang/releases/download/v2026.14.1/slang-2026.14.1-linux-x86_64-glibc-2.27.tar.gz",
          "sha256": "427d9985aac9e88912429bf9e7c1a3543bf35a61aaa855c890eeb96920175e0c",
          "only-arches": [
            "x86_64"
          ]
        }
      ]
    },
    {
      "name": "ptyxis-agent",
      "buildsystem": "simple",
      "build-commands": [
        "meson setup _build --prefix=/app --libexecdir=libexec --buildtype=release -Dagent-only=true -Dlibc-compat=true",
        "ninja -C _build agent/ptyxis-agent",
        "install -Dm755 _build/agent/ptyxis-agent /app/libexec/ptyxis-agent"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/kreed/ptyxis.git",
          "tag": "kitty-chrome-20260820",
          "commit": "15e2d153501c25f80d01b82e69a03950c1b89a22"
        }
      ]
    },
    {
      "name": "kitty",
      "buildsystem": "simple",
      "build-options": {
        "build-args": [
          "--share=network"
        ],
        "env": {
          "GOTOOLCHAIN": "local",
          "LD_LIBRARY_PATH": "/app/lib",
          "PATH": "/app/go/bin:/app/bin:/usr/bin"
        }
      },
      "build-commands": [
        "mkdir -p fonts docs/_build/html docs/_build/man",
        "cp nerd-fonts/SymbolsNerdFontMono-Regular.ttf fonts/",
        "python3 setup.py linux-package --prefix=/app --update-check-interval=0 --shell-integration='enabled no-rc'",
        "rm -f /app/share/applications/kitty.desktop /app/share/applications/kitty-open.desktop",
        "mv /app/share/icons/hicolor/256x256/apps/kitty.png /app/share/icons/hicolor/256x256/apps/io.github.kreed.KittyChrome.png",
        "mv /app/share/icons/hicolor/scalable/apps/kitty.svg /app/share/icons/hicolor/scalable/apps/io.github.kreed.KittyChrome.svg",
        "rm -rf /app/go"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/kreed/kitty.git",
          "commit": "d2d2714f8118d031926dd29d9f64b62567f530c4"
        },
        {
          "type": "archive",
          "url": "https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.0/NerdFontsSymbolsOnly.tar.xz",
          "sha256": "b7ef2283462b435f1fe91d729dc412d5dbe34269dd2c7f4e1d803e4105c8d883",
          "dest": "nerd-fonts",
          "strip-components": 0
        }
      ]
    },
    {
      "name": "kitty-chrome",
      "buildsystem": "simple",
      "build-commands": [
        "cc -std=gnu11 -O2 -o kitty-host-agent host-agent.c $(pkg-config --cflags --libs gio-2.0 gio-unix-2.0)",
        "cc -std=gnu11 -O2 -o kitty-chrome-host-pty host-bridge.c $(pkg-config --cflags --libs gio-2.0 gio-unix-2.0)",
        "install -Dm755 kitty-host-agent /app/libexec/kitty-host-agent",
        "install -Dm755 kitty-chrome-host-pty /app/libexec/kitty-chrome-host-pty",
        "install -Dm755 kitty-chrome /app/bin/kitty-chrome",
        "install -Dm755 -t /app/bin host-bin/wssh host-bin/podman host-bin/distrobox host-bin/toolbox",
        "install -Dm644 io.github.kreed.KittyChrome.desktop /app/share/applications/io.github.kreed.KittyChrome.desktop",
        "install -Dm644 io.github.kreed.KittyChrome.metainfo.xml /app/share/metainfo/io.github.kreed.KittyChrome.metainfo.xml"
      ],
      "sources": [
        {
          "type": "file",
          "path": "src/host-agent.c"
        },
        {
          "type": "file",
          "path": "src/host-bridge.c"
        },
        {
          "type": "file",
          "path": "src/kitty-chrome"
        },
        {
          "type": "file",
          "path": "src/host-bin/wssh",
          "dest": "host-bin"
        },
        {
          "type": "file",
          "path": "src/host-bin/podman",
          "dest": "host-bin"
        },
        {
          "type": "file",
          "path": "src/host-bin/distrobox",
          "dest": "host-bin"
        },
        {
          "type": "file",
          "path": "src/host-bin/toolbox",
          "dest": "host-bin"
        },
        {
          "type": "file",
          "path": "io.github.kreed.KittyChrome.desktop"
        },
        {
          "type": "file",
          "path": "io.github.kreed.KittyChrome.metainfo.xml"
        }
      ]
    }
  ]
}
